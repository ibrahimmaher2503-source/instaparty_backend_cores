includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - app
        - database

    # Tests are validated by Pest, not PHPStan — Pest's $this magic is hostile to static analysis at level 8
    excludePaths:
        - app/Filament (?)
        - app/Http/Controllers/Auth (?)
        - app/Modules/*/Filament/**/* (?)
        - app/Console/Commands/SetupDevEnvironmentCommand.php (?)
        - database/migrations/*activity_log* (?)

    ignoreErrors:
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
        # Eloquent dynamic attribute access on models — PHPStan can't infer columns
        -
            message: '#Access to an undefined property .+::\$(id|public_id|name|created_at|updated_at|deleted_at|.+_id|.+_at)\.#'
            path: app/*
        # Sanctum's currentAccessToken() PHPDoc claims PersonalAccessToken,
        # but at runtime returns TransientToken for cookie auth — runtime guard required
        -
            message: '#Instanceof between Laravel\\Sanctum\\PersonalAccessToken and Laravel\\Sanctum\\PersonalAccessToken will always evaluate to true#'
            path: app/Modules/Identity/Application/Actions/LogoutAction.php
        -
            message: '#Unreachable statement - code above always terminates#'
            path: app/Modules/Identity/Application/Actions/LogoutAction.php
