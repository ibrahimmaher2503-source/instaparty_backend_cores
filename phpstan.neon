includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - database
        - tests

    excludePaths:
        - app/Filament (?)
        - app/Http/Controllers/Auth (?)
        - app/Modules/*/Filament (?)
        - app/Console/Commands/SetupDevEnvironmentCommand.php (?)
        - database/migrations/*activity_log* (?)
        - tests/Unit/ExampleTest.php (?)
        - tests/Feature/ExampleTest.php (?)

    ignoreErrors:
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
        # Eloquent dynamic attribute access on models — PHPStan can't infer columns
        -
            message: '#Access to an undefined property .+::\$(id|public_id|name|created_at|updated_at|deleted_at|.+_id|.+_at)\.#'
            path: app/*
        -
            message: '#Access to an undefined property .+::\$(id|public_id|name|created_at|updated_at|deleted_at|.+_id|.+_at|governorate_id|region_id|country_id|user_id)\.#'
            path: tests/*
        # Pest expect()/and() template inference is noisy
        -
            message: '#Unable to resolve the template type T(Value|AndValue) in call to (function expect|method Pest\\Expectation)#'
            path: tests/*
        # MoneyCast tests use Mockery for Model arg
        -
            message: '#Parameter \#1 \$model of method App\\Modules\\Shared\\Domain\\Casts\\MoneyCast::(get|set)\(\) expects#'
            path: tests/Unit/Modules/Shared/MoneyCastTest.php
