meta {
  name: initiate payment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/customer/bookings/{{booking_public_id}}/payments
  body: json
  auth: inherit
}

headers {
  Accept-Language: en
  Idempotency-Key: 11111111-1111-1111-1111-111111111111
}

body:json {
  {
    "method": "card"
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
