meta {
  name: 05 Show refund (admin)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/admin/refunds/{{refundPublicId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Accept-Language: en
}

docs {
  Admin fetches a refund's current state (status, gateway_ref, processed_at).
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
