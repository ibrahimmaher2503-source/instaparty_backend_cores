meta {
  name: 01 Initiate payment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/customer/bookings/{{bookingPublicId}}/payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept-Language: en
  Idempotency-Key: 11111111-1111-1111-1111-111111111111
}

body:json {
  {
    "method": "card"
  }
}

docs {
  Customer initiates a Paymob hosted-checkout intent on a confirmed booking.
  - Phase 1 only accepts `method=card`.
  - `Idempotency-Key` is required (24h replay window).
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
